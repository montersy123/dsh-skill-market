# Dependencies, if a checkout ever grows any
node_modules/

# Packing and install scratch — rebuilt by `npm run install:plugin`
scripts/dist/
scripts/dev/asar-out/
*.tgz

# The extracted runtime copy. It is megabytes of the Harness's own packages, reproducible with
# `node scripts/dev/asar-extract.mjs`, and not ours to publish.
scripts/dev/asar-out/

# Runtime state. `data/` holds parked skills and the install ledger, and it belongs to the user's
# profile, never to the repository — the plugin resolves it outside the package for exactly that reason.
data/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
