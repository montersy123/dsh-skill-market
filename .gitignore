# Dependencies, if a checkout ever grows any
node_modules/

# Generated scratch, rebuilt on demand:
#   scripts/dev/asar-out/    the runtime copies extracted from app.asar (`scripts/dev/asar-extract.mjs`)
#   scripts/dev/reactsmoke/  the scratch jsdom + React install the render harness runs against
#   scripts/dist/            the tarball `npm run install:plugin` builds and installs
# They are megabytes of other people's code, none of it ours to publish, and all of it reproducible.
scripts/dev/asar-out/
scripts/dev/reactsmoke/
scripts/dist/
*.tgz

# Runtime state. `data/` holds parked skills and the install ledger, and it belongs to the user's profile,
# never to the repository — the plugin resolves it outside the package for exactly that reason.
data/

# Scratch used to pass a multi-line commit message to `git commit -F`. `git add -A` picks these up, and it
# happened twice: the file was committed with the change it described, then had to be removed in a follow-up.
# Ignoring the shape means the mistake cannot recur.
.commit-message
commit-msg.txt
COMMIT_EDITMSG

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
