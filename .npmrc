# Publish against the real npm registry, not a mirror.
#
# The machine's global registry is `registry.npmmirror.com`, a read-only mirror: it serves packages but does not
# accept a publish, so `npm publish` fails against it with a confusing 403. Setting it here overrides the global
# setting for anything run from this repository, without changing how the rest of the machine installs packages.
registry=https://registry.npmjs.org/

# Scoped packages default to private on npm, which needs a paid plan. This package is meant to be public, and
# `publishConfig.access` in package.json says the same thing — the two agree rather than one silently winning.
access=public
